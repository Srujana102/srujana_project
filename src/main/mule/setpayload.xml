	<api-gateway:autodiscovery apiId="20887252" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="23191528-4a4d-4f45-8ba6-68df680d536f" flowRef="setpayloadFlow" />
	<flow name="setpayloadFlow" doc:id="d89907b0-b5b6-443d-9f27-f971c8a054a4" >
