		<set-variable value="#[payload]" doc:name="Set Variable" doc:id="f687ae48-e994-44c9-886d-7d1572cc9027" variableName="flights1"/>
		<db:select doc:name="Select" doc:id="ecdf1b2a-13ee-49d8-a1f3-ac6701ad041d" config-ref="Database_Config">
			<db:sql><![CDATA[select * from accounts]]></db:sql>
		</db:select>
		<set-payload value="#[vars.flights1]" doc:name="Set Payload" doc:id="c8737961-2cab-4817-8bf8-a3e8703e5bd2" />
		<ee:transform doc:name="Transform Message" doc:id="e7faf12e-7b6e-4421-b7d3-5f12d032a7e0" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
	"message" : payload
} 
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="637760e3-7658-48b3-92b6-c17d3b6d595f" />
	</flow>
